# ZYGARDE | MINEVERSE — EXAMPLE ONLY
# Never share your actual .env, Discord bot token, AMP password, or logs containing private data.
# Keep your private .env only on your own computer, after rotating exposed credentials.

DISCORD_TOKEN=PASTE_NEW_ROTATED_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_GUILD_ID
CHAT_CHANNEL_ID=YOUR_MINECRAFT_CHAT_CHANNEL_ID
ALERT_CHANNEL_ID=YOUR_ALERTS_CHANNEL_ID
# Optional: use a dedicated #server-status channel. Blank = alert channel.
DASHBOARD_CHANNEL_ID=
# Optional: Discord staff role ID; Discord server administrators are always allowed.
MANAGER_ROLE_ID=
SERVER_NAME=Mineverse

# Example local AMP 2 ADS proxy. Use your own AMP port and instance ID.
AMP_URL=http://127.0.0.1:8080
AMP_INSTANCE_ID=YOUR_INSTANCE_ID
AMP_USERNAME=YOUR_AMP_BOT_USERNAME
AMP_PASSWORD=PASTE_NEW_ROTATED_AMP_PASSWORD

BRIDGE_DISCORD_TO_MC=true
# "username" uses real Discord handle (recommended). "display" uses server nickname / fancy Unicode.
DISCORD_MC_NAME_SOURCE=username
USE_WEBHOOK_AVATARS=true
# MCHeads skin face images; see data/player_avatars.example.json if a player shows Steve/Alex.
USE_PLAYER_AVATARS=true
PLAYER_EVENTS_IN_CHAT=true
CHAT_POLL_SECONDS=4
DASHBOARD_UPDATE_SECONDS=60

# === ZYGARDE 2.1: performance, backup health, restart scheduler ===
# spark must be installed on your Minecraft server. Checks only read console output.
PERFORMANCE_MONITOR_ENABLED=true
PERFORMANCE_POLL_SECONDS=180
PERFORMANCE_WARN_TPS=17
PERFORMANCE_WARN_MSPT=50

# Set up the ACTUAL automated backup task in AMP 2 → Mineverse → Scheduler.
# Zygarde reads AMP's backup inventory and warns if a daily backup is missing.
BACKUP_MONITOR_ENABLED=true
BACKUP_MAX_AGE_HOURS=26

# Safety: DISABLED by default. Configure a working AMP backup before enabling.
RESTART_ENABLED=false
RESTART_TIMEZONE=America/Toronto
RESTART_AT=05:00
# Refuse scheduled restart if latest AMP backup is old/unavailable.
RESTART_REQUIRE_RECENT_BACKUP=true
